#!/usr/bin/env python3
"""Toggle the resident waybar-player popup over a private D-Bus name."""

import os
import subprocess
import sys
import time
from pathlib import Path

import gi

gi.require_version("Gio", "2.0")
from gi.repository import Gio, GLib  # noqa: E402

NAME = "org.waybarplayer.Popup"
PATH = "/org/waybarplayer/Popup"
IFACE = "org.waybarplayer.Popup"
_HERE = Path(__file__).resolve().parent


def find_menu():
    for candidate in (
        _HERE.parent / "share" / "waybar-player" / "player-menu.py",
        _HERE / "player-menu.py",
        _HERE.parent / "share" / "player-menu.py",
        Path("/usr/share/waybar-player/player-menu.py"),
    ):
        if candidate.is_file():
            return candidate
    return None


def toggle():
    try:
        bus = Gio.bus_get_sync(Gio.BusType.SESSION, None)
        bus.call_sync(
            NAME, PATH, IFACE, "Toggle", None, None,
            Gio.DBusCallFlags.NONE, 300, None,
        )
        return True
    except GLib.Error:
        return False


def main():
    menu_py = find_menu()
    if menu_py is None:
        print("waybar-player: player-menu.py not found", file=sys.stderr)
        return 1
    if toggle():
        return 0

    cache = Path(os.environ.get("XDG_CACHE_HOME") or (Path.home() / ".cache"))
    cache = cache / "waybar-player"
    cache.mkdir(parents=True, exist_ok=True)
    log = cache / "menu.log"
    env = os.environ.copy()
    env["PYTHONUTF8"] = "1"
    env.setdefault("PM_CACHE", str(cache))
    with log.open("a", encoding="utf-8") as handle:
        handle.write("\n--- resident start ---\n")
        handle.flush()
        subprocess.Popen(
            [sys.executable, str(menu_py), "--resident"],
            stdout=subprocess.DEVNULL,
            stderr=handle,
            stdin=subprocess.DEVNULL,
            start_new_session=True,
            env=env,
        )
    deadline = time.monotonic() + 1.5
    while time.monotonic() < deadline:
        if toggle():
            return 0
        time.sleep(0.05)
    print("waybar-player: popup did not start", file=sys.stderr)
    return 1


if __name__ == "__main__":
    sys.exit(main())
