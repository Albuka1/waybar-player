#!/usr/bin/env python3
#
# waybar-player-status — JSON-источник для Waybar custom/player.
#
# Один долгоживущий процесс:
#   * отдельный поток читает `playerctl -a --follow metadata --format ...`;
#   * главный цикл двигает кадры диска и бегущую строку по таймеру;
#   * при отсутствии плеера playerctl перезапускается раз в секунду.
#
# Waybar читает stdout построчно, поэтому каждая строка — компактный JSON:
# {"text":"...","tooltip":"...","class":"...","percentage":N}

import json
import os
import queue
import re
import signal
import subprocess
import sys
import threading
import time
from pathlib import Path

_SCRIPT_DIR = Path(__file__).resolve().parent
for _candidate in (
    _SCRIPT_DIR,
    _SCRIPT_DIR.parent / "share" / "waybar-player",
    _SCRIPT_DIR.parent / "share",
    Path("/usr/share/waybar-player"),
):
    if (_candidate / "i18n.py").is_file():
        sys.path.insert(0, str(_candidate))
        break
from i18n import t  # noqa: E402
import players  # noqa: E402

SEP = "\x1f"
FMT = SEP.join([
    "{{status}}", "{{playerName}}", "{{title}}", "{{artist}}",
    "{{album}}", "{{mpris:artUrl}}", "{{volume}}",
])

FRAMES = ("◐", "◓", "◑", "◒")
ICON_PAUSE = "󰏤"
ICON_IDLE = "󰎆"

PLAY_DELAY = 0.2       # кадр диска и шаг бегущей строки (строка — раз в 2 тика)
IDLE_DELAY = 1.0       # обновление на паузе/остановке/без плеера
RETRY_BASE = 1.0       # первый перезапуск playerctl после выхода
RETRY_MAX = 5.0        # максимальная задержка экспоненциального backoff


def env_int(name, default, minimum=1):
    try:
        value = int(os.environ.get(name, ""))
    except ValueError:
        return default
    return max(minimum, value)


TITLE_WIDTH = env_int("WAYBAR_PLAYER_TITLE_WIDTH", 30, 1)


def clean_field(value):
    if not value:
        return ""
    return (value.replace("\n", " ").replace("\r", " ")
            .replace("\t", " ").replace(SEP, " "))


def status_ru(status):
    if status == "playing":
        return t("status.playing")
    if status == "paused":
        return t("status.paused")
    return t("status.stopped")


def truncate_title(text, width):
    if len(text) > width:
        return text[: width - 1] + "…"
    return text


def marquee(text, offset, width):
    """Окно шириной width, циклически сдвинутое на offset."""
    if len(text) <= width:
        return text
    separator = "   •   "
    loop = text + separator
    if not loop:
        return ""
    start = offset % len(loop)
    out = loop[start:start + width]
    if len(out) < width:
        out += loop[: width - len(out)]
    return out


def volume_percent(raw):
    """Повторяет старую bash-логику: целые проценты, две цифры дроби."""
    if not raw:
        return None
    match = re.fullmatch(r"([0-9]+)(?:\.([0-9]+))?", raw)
    if not match:
        return None
    fraction = (match.group(2) or "") + "00"
    return int(match.group(1)) * 100 + int(fraction[:2])


def parse_metadata_line(line):
    if not line:
        return None
    line = line.rstrip("\n")
    if not line:
        return None
    parts = line.split(SEP)
    if len(parts) < 7:
        parts += [""] * (7 - len(parts))
    status, player, title, artist, album, art_url, volume = parts[:7]
    return {
        "status": status.strip().lower(),
        "player": clean_field(player),
        "title": clean_field(title),
        "artist": clean_field(artist),
        "album": clean_field(album),
        "art_url": clean_field(art_url),
        "volume": clean_field(volume),
    }


def get_state(player):
    if not player:
        return None
    line = players.player_metadata(player, FMT)
    if not line:
        return None
    return parse_metadata_line(line)


def track_key(state):
    return "{}|{}|{}".format(state["player"], state["title"], state["artist"])


def song_title(state):
    return state["title"] or state["artist"] or state["player"] or t("status.no_title")


def build_status(state, tick, offset, title_width=TITLE_WIDTH):
    """Возвращает (text, tooltip, class, percentage|None)."""
    if state is None:
        return (
            ICON_IDLE,
            t("status.no_player_hint"),
            "stopped",
            None,
        )

    status = state["status"] or "stopped"
    player = state["player"]
    title = state["title"]
    artist = state["artist"]
    album = state["album"]
    song = song_title(state)
    pct = volume_percent(state["volume"])

    if status == "playing":
        cls = "playing"
        text = "{}  {}".format(FRAMES[tick % len(FRAMES)],
                               marquee(song, offset, title_width))
    elif status == "paused":
        cls = "paused"
        text = "{}  {}".format(ICON_PAUSE, truncate_title(song, title_width))
    else:
        cls = "stopped"
        if title:
            text = "{}  {}".format(ICON_PAUSE, truncate_title(song, title_width))
        else:
            text = "{}  {}".format(ICON_PAUSE, t("status.stopped_text"))

    if status == "stopped" and not title:
        tip = t("status.stopped_text")
    else:
        tip = song
        if artist:
            tip += "\n" + artist
        if album:
            tip += "\n" + album
    if player:
        tip += "\n\n" + t("status.player", player=player)
    if pct is not None:
        tip += "\n" + t("status.volume", pct=pct)
    tip += "\n" + t("status.state", status=status_ru(status))
    tip += "\n\n" + t("status.hints")
    tip += "\n" + t("status.scroll_hint")

    return text, tip, cls, pct


def status_json(state, tick, offset, title_width=TITLE_WIDTH):
    text, tooltip, cls, pct = build_status(state, tick, offset, title_width)
    payload = {"text": text, "tooltip": tooltip, "class": cls}
    if pct is not None:
        payload["percentage"] = pct
    return json.dumps(payload, ensure_ascii=False, separators=(",", ":"))


_current_proc = None


def _stop(signum, frame):
    del signum, frame
    proc = _current_proc
    if proc is not None and proc.poll() is None:
        try:
            proc.terminate()
        except OSError:
            pass
    sys.exit(0)


def retry_delay(attempt):
    """1, 2, 4, 5, 5, ... секунд — без бесконечного спама процессов."""
    return min(RETRY_MAX, RETRY_BASE * (2 ** attempt))


def _wait_retry(delay, stop_event):
    if stop_event is not None:
        return stop_event.wait(delay)
    time.sleep(delay)
    return False


def reader_loop(events, stop_event=None):
    """Читает playerctl --follow и складывает состояния в очередь."""
    global _current_proc
    attempt = 0
    while stop_event is None or not stop_event.is_set():
        try:
            proc = subprocess.Popen(
                ["playerctl", "-a", "--follow", "metadata", "--format", FMT],
                stdout=subprocess.PIPE,
                stderr=subprocess.DEVNULL,
                text=True,
                encoding="utf-8",
                errors="replace",
                bufsize=1,
            )
        except OSError:
            events.put(None)
            delay = retry_delay(attempt)
            attempt += 1
            if _wait_retry(delay, stop_event):
                break
            continue

        attempt = 0
        _current_proc = proc
        try:
            for line in proc.stdout:
                state = parse_metadata_line(line)
                if state is not None:
                    events.put(state)
        except (OSError, ValueError):
            pass
        finally:
            try:
                proc.terminate()
            except OSError:
                pass
            _current_proc = None

        events.put(None)
        delay = retry_delay(attempt)
        attempt += 1
        if _wait_retry(delay, stop_event):
            break


def main():
    if hasattr(sys.stdout, "reconfigure"):
        sys.stdout.reconfigure(encoding="utf-8", errors="replace")
    signal.signal(signal.SIGTERM, _stop)
    signal.signal(signal.SIGINT, _stop)

    events = queue.Queue()
    threading.Thread(target=reader_loop, args=(events,), daemon=True).start()

    selected = players.update_selection()
    state = get_state(selected) if selected else None
    prev_key = track_key(state) if state else None
    tick = 0
    offset = 0
    next_tick = time.monotonic() + 0.1

    while True:
        timeout = max(0.0, next_tick - time.monotonic())
        changed = False
        try:
            item = events.get(timeout=timeout)
        except queue.Empty:
            item = ...
        else:
            while True:
                new_selected = players.update_selection()
                if new_selected != selected:
                    selected = new_selected
                    state = get_state(selected) if selected else None
                    prev_key = track_key(state) if state else None
                    offset = 0
                    changed = True
                elif item is None:
                    if not selected and state is not None:
                        state = None
                        prev_key = None
                        offset = 0
                        changed = True
                elif selected and item["player"] == selected:
                    key = track_key(item)
                    if key != prev_key:
                        prev_key = key
                        offset = 0
                    state = item
                    changed = True
                try:
                    item = events.get_nowait()
                except queue.Empty:
                    break

        now = time.monotonic()
        due = now >= next_tick
        if state is None or state["status"] != "playing":
            offset = 0
        if changed or due:
            print(status_json(state, tick, offset), flush=True)

        if due:
            if state is not None and state["status"] == "playing":
                tick += 1
                if tick % 2 == 0:
                    offset += 1
                next_tick = now + PLAY_DELAY
            else:
                offset = 0
                next_tick = now + IDLE_DELAY


if __name__ == "__main__":
    main()
