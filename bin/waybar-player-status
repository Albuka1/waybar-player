#!/usr/bin/env python3
#
# waybar-player-status — JSON status for Waybar, driven by async MPRIS D-Bus.
# No external player process. Output format is compatible with 0.3.1.

import json
import os
import re
import signal
import sys
import time
from pathlib import Path

_SCRIPT_DIR = Path(__file__).resolve().parent
for _candidate in (
    _SCRIPT_DIR,
    _SCRIPT_DIR.parent / "share" / "waybar-player",
    _SCRIPT_DIR.parent / "share",
    Path("/usr/share/waybar-player"),
):
    if (_candidate / "i18n.py").is_file():
        sys.path.insert(0, str(_candidate))
        break

from gi.repository import GLib  # noqa: E402

from i18n import t  # noqa: E402
import mpris  # noqa: E402
import players  # noqa: E402

FRAMES = ("◐", "◓", "◑", "◒")
ICON_PAUSE = "󰏤"
ICON_IDLE = "󰎆"

PLAY_DELAY = 0.2
IDLE_DELAY = 1.0
DEBOUNCE_MS = 50
RESYNC_MS = 30_000


def env_int(name, default, minimum=1):
    try:
        value = int(os.environ.get(name, ""))
    except ValueError:
        return default
    return max(minimum, value)


TITLE_WIDTH = env_int("WAYBAR_PLAYER_TITLE_WIDTH", 30, 1)


def clean_field(value):
    if not value:
        return ""
    return (value.replace("\n", " ").replace("\r", " ")
            .replace("\t", " ").replace("\x1f", " "))


def status_ru(status):
    if status == "playing":
        return t("status.playing")
    if status == "paused":
        return t("status.paused")
    return t("status.stopped")


def truncate_title(text, width):
    if len(text) > width:
        return text[: width - 1] + "…"
    return text


def marquee(text, offset, width):
    if len(text) <= width:
        return text
    loop = text + "   •   "
    start = offset % len(loop)
    out = loop[start:start + width]
    if len(out) < width:
        out += loop[: width - len(out)]
    return out


def volume_percent(raw):
    if not raw:
        return None
    match = re.fullmatch(r"([0-9]+)(?:\.([0-9]+))?", str(raw))
    if not match:
        return None
    fraction = (match.group(2) or "") + "00"
    return int(match.group(1)) * 100 + int(fraction[:2])


def track_key(state):
    return "{}|{}|{}".format(state["player"], state["title"], state["artist"])


def song_title(state):
    return state["title"] or state["artist"] or state["player"] or t("status.no_title")


def state_from_player(player):
    if player is None:
        return None
    volume = "" if player.volume is None else "{:.6f}".format(player.volume)
    return {
        "status": (player.status or "stopped").lower(),
        "player": player.base_name,
        "title": clean_field(player.title()),
        "artist": clean_field(player.artist()),
        "album": clean_field(player.album()),
        "art_url": player.art_url(),
        "volume": volume,
        "track_id": player.track_id(),
        "track_url": player.track_url(),
    }


def build_status(state, tick, offset, title_width=TITLE_WIDTH):
    if state is None:
        return (
            ICON_IDLE,
            t("status.no_player_hint"),
            "stopped",
            None,
        )

    status = state["status"] or "stopped"
    player = state["player"]
    title = state["title"]
    artist = state["artist"]
    album = state["album"]
    song = song_title(state)
    pct = volume_percent(state["volume"])

    if status == "playing":
        cls = "playing"
        text = "{}  {}".format(FRAMES[tick % len(FRAMES)],
                               marquee(song, offset, title_width))
    elif status == "paused":
        cls = "paused"
        text = "{}  {}".format(ICON_PAUSE, truncate_title(song, title_width))
    else:
        cls = "stopped"
        if title:
            text = "{}  {}".format(ICON_PAUSE, truncate_title(song, title_width))
        else:
            text = "{}  {}".format(ICON_PAUSE, t("status.stopped_text"))

    if status == "stopped" and not title:
        tip = t("status.stopped_text")
    else:
        tip = song
        if artist:
            tip += "\n" + artist
        if album:
            tip += "\n" + album
    if player:
        tip += "\n\n" + t("status.player", player=player)
    if pct is not None:
        tip += "\n" + t("status.volume", pct=pct)
    tip += "\n" + t("status.state", status=status_ru(status))
    tip += "\n\n" + t("status.hints")
    tip += "\n" + t("status.scroll_hint")

    return text, tip, cls, pct


def status_json(state, tick, offset, title_width=TITLE_WIDTH):
    text, tooltip, cls, pct = build_status(state, tick, offset, title_width)
    payload = {"text": text, "tooltip": tooltip, "class": cls}
    if pct is not None:
        payload["percentage"] = pct
    return json.dumps(payload, ensure_ascii=False, separators=(",", ":"))


def write_seed(state):
    if state is None:
        return
    path = players.RUNTIME_DIR / "state.json"
    try:
        players.RUNTIME_DIR.mkdir(parents=True, exist_ok=True)
        temporary = path.with_name(".state.{}.tmp".format(os.getpid()))
        with temporary.open("w", encoding="utf-8") as handle:
            json.dump(state, handle, ensure_ascii=False, separators=(",", ":"))
            handle.write("\n")
        os.replace(temporary, path)
    except OSError:
        pass


def main():
    if hasattr(sys.stdout, "reconfigure"):
        sys.stdout.reconfigure(
            encoding="utf-8", errors="replace", line_buffering=True
        )

    loop = GLib.MainLoop()
    state = {"text": None}
    runtime = {
        "selected": None,
        "state": None,
        "last_json": None,
        "tick": 0,
        "offset": 0,
        "debounce_id": 0,
    }

    def schedule():
        if runtime["debounce_id"]:
            return
        runtime["debounce_id"] = GLib.timeout_add(DEBOUNCE_MS, refresh)

    def render(force=False):
        current = runtime["state"]
        line = status_json(current, runtime["tick"], runtime["offset"])
        if force or line != runtime["last_json"]:
            runtime["last_json"] = line
            print(line, flush=True)

    def refresh():
        runtime["debounce_id"] = 0
        by_name = manager.players
        names = list(by_name)
        statuses = {name: by_name[name].status for name in names}
        identities = {
            name: {
                "desktop_entry": by_name[name].desktop_entry,
                "identity": by_name[name].identity,
                "base": by_name[name].base_name,
            }
            for name in names
        }
        selected = players.update_selection(names, statuses, identities)
        runtime["selected"] = selected
        current = state_from_player(by_name.get(selected)) if selected else None
        if current != runtime["state"]:
            if runtime["state"] is None or current is None:
                runtime["offset"] = 0
            elif track_key(current) != track_key(runtime["state"]):
                runtime["offset"] = 0
            runtime["state"] = current
            write_seed(current)
        render()
        return False

    def frame_tick():
        current = runtime["state"]
        if current is not None and current["status"] == "playing":
            runtime["tick"] += 1
            if runtime["tick"] % 2 == 0:
                runtime["offset"] += 1
            render()
        else:
            runtime["offset"] = 0
        return True

    def resync():
        manager.refresh_all(schedule)
        return True

    def stop(_signum=None, _frame=None):
        loop.quit()
        return False

    signal.signal(signal.SIGTERM, stop)
    signal.signal(signal.SIGINT, stop)

    manager = mpris.MprisManager(schedule)
    manager.start(schedule)
    GLib.timeout_add(int(PLAY_DELAY * 1000), frame_tick)
    GLib.timeout_add(RESYNC_MS, resync)
    loop.run()
    return 0


if __name__ == "__main__":
    sys.exit(main())
