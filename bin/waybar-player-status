#!/usr/bin/env bash
#
# player-status.sh — источник данных для Waybar-модуля custom/player.
#
# Скрипт работает в бесконечном цикле: Waybar читает stdout построчно и
# обновляет модуль на каждой строке (в конфиге НЕ задан interval, поэтому
# Waybar считает скрипт "самозацикленным" и не перезапускает его).
#
# Формат строки — JSON: {"text": "...", "tooltip": "...", "class": "...", "percentage": N}
# В конфиге включён "escape": true, поэтому Waybar сам экранирует разметку
# (символы &, <, > в названиях треков не ломают Pango-разметку).

set -uo pipefail

# UTF-8 обязателен: ${#str} и ${str:off:len} должны считать символы, а не байты.
export LC_ALL=C.UTF-8

# \x1f (unit separator) — разделитель, который не является IFS-пробелом,
# поэтому пустые поля (например, отсутствующий исполнитель) не "схлопываются".
readonly SEP=$'\x1f'
readonly FMT="{{status}}${SEP}{{playerName}}${SEP}{{title}}${SEP}{{artist}}${SEP}{{album}}${SEP}{{mpris:artUrl}}${SEP}{{volume}}"

readonly FRAMES=(◐ ◓ ◑ ◒)
readonly ICON_PAUSE="󰏤"
readonly ICON_IDLE="󰎆"

readonly TITLE_WIDTH=30      # сколько символов трека показывать на панели
readonly PLAY_DELAY=0.2      # период анимации/бегущей строки при воспроизведении
readonly IDLE_DELAY=1.0      # период опроса на паузе/остановке/без плеера
readonly PCTL_TIMEOUT=1      # жёсткий таймаут на один вызов playerctl

json_escape() {
    local s=$1
    s=${s//\\/\\\\}
    s=${s//\"/\\\"}
    s=${s//$'\n'/\\n}
    s=${s//$'\r'/\\r}
    s=${s//$'\t'/\\t}
    s=${s//$'\b'/\\b}
    s=${s//$'\f'/\\f}
    printf '%s' "$s"
}

# Убираем переводы строк/табы из метаданных, чтобы строка JSON осталась одной строкой.
clean_field() {
    local s=$1
    s=${s//$'\n'/ }
    s=${s//$'\r'/ }
    s=${s//$'\t'/ }
    s=${s//"$SEP"/ }
    printf '%s' "$s"
}

truncate_title() {
    local s=$1 width=$2
    if (( ${#s} > width )); then
        printf '%s…' "${s:0:width-1}"
    else
        printf '%s' "$s"
    fi
}

# Бегущая строка: окно шириной width символов, сдвигающееся по кругу.
marquee() {
    local s=$1 off=$2 width=$3
    # Короткий заголовок не дублируем и не прокручиваем.
    if (( ${#s} <= width )); then
        printf '%s' "$s"
        return
    fi
    local gap="   •   "
    local loop="${s}${gap}"
    local len=${#loop}
    (( len == 0 )) && return
    local start=$(( off % len ))
    local out="${loop:start:width}"
    if (( ${#out} < width )); then
        out+="${loop:0:width-${#out}}"
    fi
    printf '%s' "$out"
}

# playerctl отдаёт громкость как float (0.0…1.0). Считаем проценты без внешних утилит.
volume_percent() {
    local v=$1 int frac
    [[ $v =~ ^([0-9]+)(\.([0-9]+))?$ ]] || return 1
    int=$((10#${BASH_REMATCH[1]}))
    frac="${BASH_REMATCH[3]:-}"
    frac="${frac}00"
    printf '%d' $(( int * 100 + 10#${frac:0:2} ))
}

status_ru() {
    case $1 in
        playing) printf 'Играет' ;;
        paused)  printf 'Пауза' ;;
        *)       printf 'Остановлен' ;;
    esac
}

prev_key=""
offset=0
tick=0

while :; do
    meta=""
    status=""
    player=""
    title=""
    artist=""
    album=""
    art_url=""
    volume=""

    if meta=$(timeout "$PCTL_TIMEOUT" playerctl metadata --format "$FMT" 2>/dev/null) && [[ -n $meta ]]; then
        IFS="$SEP" read -r status player title artist album art_url volume <<<"$meta"
    else
        meta=""
    fi

    title=$(clean_field "${title:-}")
    artist=$(clean_field "${artist:-}")
    album=$(clean_field "${album:-}")
    art_url=$(clean_field "${art_url:-}")
    player=$(clean_field "${player:-}")
    volume=$(clean_field "${volume:-}")

    class="stopped"
    vol_pct=""

    if [[ -n $volume ]] && vol_pct=$(volume_percent "$volume"); then
        :
    else
        vol_pct=""
    fi

    if [[ -z $meta ]]; then
        # Нет ни одного MPRIS-плеера (или playerctl не ответил за PCTL_TIMEOUT).
        status_norm=""
        song=""
        text="$ICON_IDLE"
        tip="Нет активного MPRIS-плеера"
        tip+=$'\n\n'"ЛКМ — открыть меню"
    else
        status_norm=${status,,}
        [[ -n $status_norm ]] || status_norm="stopped"

        if [[ -n $title ]]; then
            song=$title
        elif [[ -n $artist ]]; then
            song=$artist
        elif [[ -n $player ]]; then
            song=$player
        else
            song="Без названия"
        fi

        case $status_norm in
            playing)
                class="playing"
                key="${player}|${title}|${artist}"
                if [[ $key != "$prev_key" ]]; then
                    prev_key=$key
                    offset=0
                fi
                display=$(marquee "$song" "$offset" "$TITLE_WIDTH")
                text="${FRAMES[$((tick % 4))]}  ${display}"
                ;;

            paused)
                class="paused"
                offset=0
                display=$(truncate_title "$song" "$TITLE_WIDTH")
                text="${ICON_PAUSE}  ${display}"
                ;;

            *)
                class="stopped"
                offset=0
                if [[ -n $title ]]; then
                    text="${ICON_PAUSE}  $(truncate_title "$song" "$TITLE_WIDTH")"
                else
                    text="${ICON_PAUSE}  Остановлено"
                fi
                ;;
        esac

        if [[ $status_norm == "stopped" && -z $title ]]; then
            tip="Остановлено"
        else
            tip="$song"
            [[ -n $artist ]] && tip+=$'\n'"$artist"
            [[ -n $album ]] && tip+=$'\n'"$album"
        fi
        [[ -n $player ]] && tip+=$'\n\n'"Плеер: $player"
        [[ -n $vol_pct ]] && tip+=$'\n'"Громкость: ${vol_pct}%"
        tip+=$'\n'"Состояние: $(status_ru "$status_norm")"
        tip+=$'\n\n'"ЛКМ — меню • СКМ — предыдущий • ПКМ — пауза/плей"
        tip+=$'\n'"Колесо — громкость"
    fi

    esc_text=$(json_escape "$text")
    esc_tip=$(json_escape "$tip")
    if [[ -n $vol_pct ]]; then
        printf '{"text":"%s","tooltip":"%s","class":"%s","percentage":%s}\n' \
            "$esc_text" "$esc_tip" "$class" "$vol_pct"
    else
        printf '{"text":"%s","tooltip":"%s","class":"%s"}\n' \
            "$esc_text" "$esc_tip" "$class"
    fi

    if [[ $class == "playing" ]]; then
        tick=$((tick + 1))
        # Диск крутится каждые 0.2 с, а бегущая строка сдвигается вдвое медленнее,
        # чтобы её можно было прочитать (2.5 символа в секунду).
        if (( tick % 2 == 0 )); then
            offset=$((offset + 1))
        fi
        sleep "$PLAY_DELAY"
    else
        sleep "$IDLE_DELAY"
    fi
done
