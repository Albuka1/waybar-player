#!/usr/bin/env python3
"""Control the explicitly selected MPRIS player."""

import subprocess
import sys
from pathlib import Path

_HERE = Path(__file__).resolve().parent
for _candidate in (
    _HERE.parent / "share" / "waybar-player",
    _HERE.parent / "share",
    Path("/usr/share/waybar-player"),
):
    if (_candidate / "players.py").is_file():
        sys.path.insert(0, str(_candidate))
        break

import players  # noqa: E402

COMMANDS = {
    "play-pause",
    "previous",
    "next",
    "volume-up",
    "volume-down",
    "shuffle",
    "loop",
}


def pctl(player, *args, timeout=2):
    try:
        return subprocess.run(
            ["playerctl", "-p", player, *args],
            stdout=subprocess.PIPE,
            stderr=subprocess.DEVNULL,
            text=True,
            encoding="utf-8",
            errors="replace",
            timeout=timeout,
        )
    except (OSError, subprocess.SubprocessError):
        return None


def loop_next(value):
    return {"none": "track", "track": "playlist", "playlist": "none"}.get(value)


def loop_command(value):
    return {"none": "None", "track": "Track", "playlist": "Playlist"}.get(value)


def read_value(player, command):
    result = pctl(player, command)
    if result is None or result.returncode != 0:
        return None
    value = result.stdout.strip().lower()
    return value or None


def _ok(result):
    return result is not None and result.returncode == 0


def run(command, player):
    if command == "play-pause":
        return _ok(pctl(player, "play-pause"))
    if command == "previous":
        return _ok(pctl(player, "previous"))
    if command == "next":
        return _ok(pctl(player, "next"))
    if command == "volume-up":
        return _ok(pctl(player, "volume", "0.05+"))
    if command == "volume-down":
        return _ok(pctl(player, "volume", "0.05-"))
    if command == "shuffle":
        current = read_value(player, "shuffle")
        if current not in ("on", "off"):
            return False
        return _ok(pctl(player, "shuffle", "Toggle"))
    if command == "loop":
        current = read_value(player, "loop")
        target = loop_next(current)
        if target is None:
            return False
        return _ok(pctl(player, "loop", loop_command(target)))
    return False


def main(argv):
    if len(argv) != 2 or argv[1] not in COMMANDS:
        print("usage: waybar-player-ctl {%s}" % "|".join(sorted(COMMANDS)), file=sys.stderr)
        return 2
    selected = players.update_selection()
    if not selected:
        return 1
    return 0 if run(argv[1], selected) else 1


if __name__ == "__main__":
    sys.exit(main(sys.argv))
